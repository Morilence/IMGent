{
  "name": "imgent",
  "version": "0.1.0",
  "description": "IMGent is a self-hosted bridge from QQ and WeChat iLink to local Codex and Claude Code agents",
  "license": "Apache-2.0",
  "keywords": [
    "qq",
    "wechat",
    "codex",
    "claude-code",
    "agent",
    "cli"
  ],
  "homepage": "https://github.com/Morilence/IMGent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morilence/IMGent.git"
  },
  "bugs": {
    "url": "https://github.com/Morilence/IMGent/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "files": [
    "dist/src/cli/main.js",
    "dist/src/cli/main.js.map",
    "skills"
  ],
  "bin": {
    "imgent": "dist/src/cli/main.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build.mjs",
    "changeset": "changeset",
    "ci:publish": "changeset publish",
    "ci:version": "changeset version",
    "clean": "tsc -b --clean",
    "prepare": "husky",
    "prepack": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -b --pretty false",
    "test": "tsc -b && node --test --test-reporter=spec dist/tests/*.test.js",
    "verify:codex": "tsc -b && node scripts/codex-real-smoke.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "start": "node dist/src/cli/main.js start",
    "imgent": "node dist/src/cli/main.js",
    "dev": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.218",
    "@anthropic-ai/sdk": "^0.113.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@eslint/js": "10.0.1",
    "@imgent/adapter-qq": "workspace:*",
    "@imgent/adapter-wechat-ilink": "workspace:*",
    "@imgent/contracts": "workspace:*",
    "@imgent/driver-claude-code": "workspace:*",
    "@imgent/driver-codex": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.1.1",
    "prettier": "3.9.6",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "typescript-eslint": "8.65.0"
  }
}
